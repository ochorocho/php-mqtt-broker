#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use PhpMqtt\Broker\Auth\PasswordFile;

// Parsed by hand rather than with getopt(), which stops at the first non-option:
// "mqtt-passwd file user -b pw" would silently lose the -b and start prompting.
// Every option here is a bare switch, so none consumes a following value.
$batch = false;
$delete = false;
$wantsHelp = false;
$positional = [];

foreach (array_slice($argv, 1) as $argument) {
    switch ($argument) {
        case '-b':
            $batch = true;
            break;
        case '-D':
            $delete = true;
            break;
        case '-bD':
        case '-Db':
            $batch = true;
            $delete = true;
            break;
        case '--help':
        case '-h':
            $wantsHelp = true;
            break;
        default:
            if (str_starts_with($argument, '-') && $argument !== '-') {
                fwrite(STDERR, sprintf("Unknown option: %s\n", $argument));
                exit(1);
            }
            $positional[] = $argument;
    }
}

if ($wantsHelp || $positional === []) {
    echo <<<USAGE
    Usage: mqtt-passwd [options] <file> <username> [password]

      mqtt-passwd <file> <username>          Set a password, prompting twice
      mqtt-passwd -b <file> <username> <pw>  Set a password without prompting
      mqtt-passwd -D <file> <username>       Delete a user

    Options:
      -b          Batch mode: take the password as an argument. Convenient for
                  scripts, but the password is visible in the process list and
                  the shell history.
      -D          Delete the named user.
      --help      Show this message.

    The file is created with mode 0600 if it does not exist. The broker reads it
    once at startup, so adding or removing a user takes effect on restart.

    USAGE;
    // Asking for help is not an error; being given no arguments is.
    exit($wantsHelp ? 0 : 1);
}

if ($batch && $delete) {
    fwrite(STDERR, "-b and -D cannot be combined\n");
    exit(1);
}

$path = $positional[0] ?? null;
$username = $positional[1] ?? null;

if ($path === null || $username === null) {
    fwrite(STDERR, "Both a file and a username are required; see --help\n");
    exit(1);
}

if ($username === '' || str_contains($username, ':')) {
    fwrite(STDERR, "Username must not be empty or contain ':'\n");
    exit(1);
}

/**
 * Read a password without echoing it, when there is a terminal to turn echo off on.
 */
$prompt = static function (string $label): string {
    $interactive = !function_exists('posix_isatty') || posix_isatty(STDIN);
    if (!$interactive) {
        fwrite(STDERR, "Not a terminal; use -b to supply the password as an argument\n");
        exit(1);
    }

    fwrite(STDERR, $label);
    shell_exec('stty -echo 2>/dev/null');
    $value = fgets(STDIN);
    shell_exec('stty echo 2>/dev/null');
    fwrite(STDERR, "\n");

    return $value === false ? '' : rtrim($value, "\r\n");
};

// An existing file is read through the same parser the broker uses, so this tool
// can never write something the broker would then refuse to start on.
$users = [];
if (is_file($path)) {
    try {
        $users = PasswordFile::parse($path);
    } catch (RuntimeException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }

    $mode = fileperms($path);
    if ($mode !== false && ($mode & 0o077) !== 0) {
        fwrite(STDERR, sprintf(
            "Warning: %s is readable by other users (mode %04o)\n",
            $path,
            $mode & 0o7777,
        ));
    }
}

if ($delete) {
    if (!array_key_exists($username, $users)) {
        fwrite(STDERR, sprintf("No such user: %s\n", $username));
        exit(1);
    }

    unset($users[$username]);

    if ($users === []) {
        fwrite(STDERR, sprintf(
            "Refusing to leave %s with no users; the broker would reject every client. "
                . "Delete the file instead.\n",
            $path,
        ));
        exit(1);
    }
} else {
    if ($batch) {
        $password = $positional[2] ?? null;
        if ($password === null) {
            fwrite(STDERR, "-b requires the password as the third argument\n");
            exit(1);
        }
    } else {
        $password = $prompt('Password: ');
        if ($password !== $prompt('Confirm: ')) {
            fwrite(STDERR, "Passwords do not match\n");
            exit(1);
        }
    }

    if ($password === '') {
        fwrite(STDERR, "Password must not be empty\n");
        exit(1);
    }

    // password_hash() throws a ValueError on a NUL byte; say so plainly instead.
    if (str_contains($password, "\0")) {
        fwrite(STDERR, "Password must not contain a null byte\n");
        exit(1);
    }

    // bcrypt silently ignores everything past 72 bytes, so a longer password is
    // not as strong as it looks.
    if (strlen($password) > 72) {
        fwrite(STDERR, "Warning: bcrypt only uses the first 72 bytes of this password\n");
    }

    $users[$username] = password_hash($password, PASSWORD_DEFAULT);
}

ksort($users);

// Write through a temporary file so an interrupted run cannot truncate the
// credential store while the broker is reading it.
$directory = dirname($path);
$temporary = tempnam($directory, '.mqtt-passwd-');
if ($temporary === false) {
    fwrite(STDERR, sprintf("Could not create a temporary file in %s\n", $directory));
    exit(1);
}

if (file_put_contents($temporary, PasswordFile::format($users)) === false) {
    unlink($temporary);
    fwrite(STDERR, "Could not write the new password file\n");
    exit(1);
}

chmod($temporary, 0o600);

if (!rename($temporary, $path)) {
    unlink($temporary);
    fwrite(STDERR, sprintf("Could not replace %s\n", $path));
    exit(1);
}

printf(
    "%s %s in %s\n",
    $delete ? 'Deleted' : 'Updated',
    $username,
    $path,
);
